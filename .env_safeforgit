# Environment: dev | prod
ENVIRONMENT=dev

# GCP Configuration
GCP_PROJECT_ID=vertex-ai-rag-agent17
GCP_REGION=us-central1

# GCS Bucket
GCS_BUCKET_NAME=vertex-ai-rag-agent17-fund-documents

# Vertex AI Search
VERTEX_SEARCH_DATA_STORE_ID=fund-knowledge-base-v2
VERTEX_SEARCH_ENGINE_ID=fund-search-engine-v2

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash

FAISS_INDEX_PATH="./src/faiss_index_fundfacts"

# PDF Sync
SYNC_PDFS_IN_DEV=false
PDF_BASE_URL=https://yoursite.com/funds

# Terraform - TF_VAR_ is a Terraform convention, not something in the code. Terraform automatically reads environment variables prefixed with TF_VAR_ and maps them to variables.
# TF_VAR_deploy_cloud_run=true  →  var.deploy_cloud_run = true
