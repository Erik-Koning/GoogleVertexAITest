# Environment: dev (API key) | workstation (service account) | prod (service account)
ENVIRONMENT=dev

# GCP Project Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Gemini Configuration
GEMINI_MODEL=gemini-2.5-flash

# API Key (dev environment only)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-api-key

# Local Vector Search (FAISS)
FAISS_INDEX_PATH=./src/faiss_index_fundfacts

# Optional: Base URL for PDF source links
PDF_BASE_URL=

# Fallback behavior
ALLOW_GENERAL_KNOWLEDGE_FALLBACK=true

# Server port
PORT=8080
