# Environment: dev | prod
ENVIRONMENT=dev

# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# GCS Bucket
GCS_BUCKET_NAME=your-project-fund-documents

# Vertex AI Search
VERTEX_SEARCH_DATA_STORE_ID=fund-knowledge-base
VERTEX_SEARCH_ENGINE_ID=fund-search-engine

# Gemini Model
GEMINI_MODEL=gemini-1.5-pro

# API Key (dev only - prod uses ADC/service account)
GOOGLE_API_KEY=your-api-key-here

# PDF Sync
SYNC_PDFS_IN_DEV=false
PDF_BASE_URL=https://yoursite.com/funds
